<!DOCTYPE html>
<html lang="<%= I18n.locale.to_s %>" prefix="og: https://ogp.me/ns#">
  <head>
    <% canonical_url = seo_canonical_url %>
    <title><%= content_for(:title) || t('web.welcome.index_v2.layout_title') %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="Keywords" content="Digital, interactive, character sheet, character builder, dungeons & dragons, pathfinder, daggerheart, dc20, fate">
    <meta name="Description" content="<%= content_for(:description) || t('web.welcome.index_v2.description') %>">
    <meta property="og:title" content="<%= t('web.welcome.index_v2.layout_title') %>" />
    <meta property="og:description" content="<%= t('web.welcome.index_v2.description') %>" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="<%= canonical_url %>" />
    <link rel="canonical" href="<%= canonical_url %>">
    <% seo_hreflang_urls.each do |hreflang, href| %>
      <link rel="alternate" hreflang="<%= hreflang %>" href="<%= href %>">
    <% end %>
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <%= stylesheet_link_tag 'tailwind' %>
    <%= stylesheet_link_tag :application %>
  </head>
  <body class="web">
    <main class="relative flex flex-col m-0 p-0 min-h-screen">
      <%= render 'controllers/web/shared/flash' %>
      <div class="w-full py-2 px-2 lg:px-0">
        <div class="max-w-7xl mx-auto flex flex-row justify-between items-center">
          <%= link_to root_path do %>
            <%= image_tag 'icon.png', alt: 'charkeeper', width: 24, height: 24 %>
          <% end %>
          <div>
            <% if current_user %>
              <%= link_to t('web.users.signin.logout'), logout_path, class: 'underline' %>
            <% else %>
              <%= link_to t('web.users.signin.title'), new_signin_path, class: 'mr-4 underline', data: { 'test-id' => 'signin-link' } %>
              <%= link_to t('web.users.signup.title'), new_signup_path, class: 'underline' %>
            <% end %>
          </div>
        </div>
      </div>
      <div class="flex flex-col flex-1 overflow-x-hidden">
        <%= yield %>
      </div>
      <%= render 'controllers/web/shared/footer' %>
    </main>
  </body>
</html>
